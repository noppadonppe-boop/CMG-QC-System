# คัดลอกเป็น .env แล้วใส่ค่าจริง (ดูจาก Firebase Console)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# n8n Webhook URL สำหรับ Extract PDF
VITE_N8N_WEBHOOK_URL=
# Optional: override the default Firebase Function URL used by the Tag No. Sync button.
VITE_GOOGLE_TAG_SYNC_WEBHOOK_URL=
# Used only by trusted server-to-server callers; never expose this as a VITE_ variable.
TAG_SYNC_SECRET=
